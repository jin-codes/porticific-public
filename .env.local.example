# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/* (Vercel sends it as `Authorization: Bearer <value>`). Generate: openssl rand -hex 24
CRON_SECRET=

# Server-side analysis. The server key pays only for OWNER_USER_ID and the weekly thesis check; other users
# bring their own key (Settings), stored encrypted with KEY_ENCRYPTION_SECRET (>= 16 chars, e.g.
# `openssl rand -hex 32`; changing it makes saved keys unreadable).
ANTHROPIC_API_KEY=
KEY_ENCRYPTION_SECRET=
# OWNER_USER_ID=
# ANALYSIS_MODEL=claude-haiku-5-5
# ANALYSIS_WEB_SEARCH=1
# ANALYSIS_MAX_TICKERS=15

# Email alerts (optional: without credentials alerts are computed but not sent)
# Free option: a Gmail account with 2-Step Verification and an app password
# (https://myaccount.google.com/apppasswords). Paste it without the spaces.
# ALERT_SMTP_USER=you@gmail.com
# ALERT_SMTP_PASS=
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=465
# ALERT_FROM=Porticific <you@gmail.com>
# Used for links inside alert mails
# NEXT_PUBLIC_SITE_URL=https://your-domain
